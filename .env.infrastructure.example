# Infrastructure API Keys Template
# Copy this file to .env.infrastructure and fill in your actual keys
# IMPORTANT: Never commit .env.infrastructure to git!

# Vultr (https://my.vultr.com/settings/#settingsapi)
VULTR_API_KEY="your-vultr-api-key-here"
VULTR_SSH_KEY_ID="your-ssh-key-id-here"

# Hetzner (https://console.hetzner.cloud/)
HETZNER_API_TOKEN="your-hetzner-api-token-here"

# PhoenixNAP (https://bmc.phoenixnap.com/)
PNAP_CLIENT_ID="your-pnap-client-id-here"
PNAP_CLIENT_SECRET="your-pnap-client-secret-here"

# DigitalOcean (https://cloud.digitalocean.com/account/api/tokens)
DO_TOKEN="your-digitalocean-token-here"

# AWS (optional)
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
