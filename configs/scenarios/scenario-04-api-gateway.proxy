# Scenario 04: API Gateway (Simplified)
# RESTful API routing with HTTPS/TLS termination
# Target: 500K+ API requests/sec with load balancing

https://api.loadtest.local:8443 {
    # TLS configuration
    tls "/mnt/e/my-opensource/highper-gateway/certs/api.crt" "/mnt/e/my-opensource/highper-gateway/certs/api.key"
    # Backend API servers
    proxy 127.0.0.1:8081 127.0.0.1:8082 127.0.0.1:8083
    # Intelligent load balancing
    lb least_conn
}

# Global settings
log info
metrics prometheus port=9090
