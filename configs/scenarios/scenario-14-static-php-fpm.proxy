# Scenario 14: Static Web Server with PHP-FPM
# Static file serving with FastCGI PHP processing
# Target: 600K+ RPS for static, 150K+ RPS for PHP

https://web.loadtest.local {
    # TLS configuration
    tls "/etc/highper/certs/web.crt" "/etc/highper/certs/web.key"
    tls_protocols TLSv1.2 TLSv1.3
    # HTTP/2 for better performance
    http2 enabled
    # Static file serving (direct from gateway)
    root /var/www/html
    static enabled
    static_cache enabled size=16gb max_age=86400s
    static_gzip enabled
    static_brotli enabled
    # Index files
    index index.php index.html index.htm
    # Backend PHP-FPM servers via FastCGI
    location ~ \.php$ {
        fastcgi 127.0.0.1:8081:9000 127.0.0.1:8082:9000 127.0.0.1:8083:9000
        fastcgi_index index.php
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name
        fastcgi_param QUERY_STRING $query_string
        fastcgi_param REQUEST_METHOD $request_method
        # PHP-FPM load balancing
        lb round_robin
        health interval=15s timeout=5s fastcgi
        # PHP-FPM timeouts
        fastcgi_connect_timeout 5s
        fastcgi_send_timeout 60s
        fastcgi_read_timeout 60s
        # FastCGI buffering
        fastcgi_buffering enabled
        fastcgi_buffer_size 16k
        fastcgi_buffers 16 16k
        # Connection pooling to PHP-FPM
        pool min_idle=200 max_idle=10000 max_open=300000
    }

    # Static file locations
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 7d
        add_header Cache-Control "public, immutable"
    }

    # Security (prevent access to hidden files)
    location ~ /\. {
        deny all
    }

    # Connection settings
    max_conns 1500000
    keepalive 90s

    # Rate limiting
    rate_limit 650000 burst=90000

    # Compression
    compress gzip br level=6
    compress_types text/html text/css application/javascript image/svg+xml

    # Headers
    header_add X-Content-Type-Options "nosniff"
    header_remove X-Powered-By
}

# Global settings
log info
metrics prometheus port=9090
buffer_pool enabled size=16384 pool_size=16777216
backpressure enabled max_conns=1500000 memory_limit=32768mb
