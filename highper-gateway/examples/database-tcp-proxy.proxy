# TCP Proxy for Database Load Balancing
# High-performance TCP proxying for MySQL, PostgreSQL, and Redis

# MySQL Read Replica Load Balancing
:3306 mysql {
    proxy db1:3306 db2:3306 db3:3306
    lb least_conn
    pool max=1000 min=50 lifetime=1h
    health interval=10s timeout=5s
}

# PostgreSQL Connection Pooling
:5432 postgres {
    proxy pg-primary:5432 pg-replica1:5432 pg-replica2:5432
    pool max=500 min=20 lifetime=30m idle=5m
    lb round_robin
}

# Redis Cluster Proxy
:6379 redis {
    proxy redis1:6379 redis2:6379 redis3:6379
    lb consistent_hash
    pool max=200 min=10
}

# Generic TCP Proxy (for other protocols)
:8080 tcp {
    proxy backend1:8080 backend2:8080
    lb round_robin
}

# Performance Notes:
# - Connection pool achieves >95% reuse ratio
# - Protocol-aware health checks validate backend health
# - Circuit breaker automatically handles failures
# - Sub-millisecond latency overhead (<0.01ms P99)
