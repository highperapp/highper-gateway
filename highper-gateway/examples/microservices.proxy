# Microservices API Gateway Configuration
# Complete example showing path-based routing, CORS, rate limiting, etc.

# Global settings
log info
admin :9090
metrics on

# API Gateway with path-based routing
https://api.example.com {
    # User service
    /api/users/* {
        proxy users-svc:8080
        rate_limit 1000 per 1m
    }

    # Order service
    /api/orders/* {
        proxy orders-svc:8080
        rate_limit 500 per 1m
    }

    # Product catalog
    /api/products/* {
        proxy products-svc:8080 products-svc-replica:8080
        lb least_conn
        rate_limit 2000 per 1m
    }

    # Authentication service
    /api/auth/* {
        proxy auth-svc:8080
        rate_limit 100 per 1m
        timeout 10s
    }

    # Global settings for all routes
    cors
    compress gzip br
    health interval=30s path="/health"
}

# Admin Dashboard
https://admin.example.com {
    proxy admin-ui:3000
    tls internal  # Self-signed for internal use
    rate_limit 100 per 1m
}

# WebSocket Server for Real-time Updates
wss://ws.example.com {
    websocket
    proxy ws-server:8081
    timeout 300s
}

# gRPC Services
grpc://services.example.com {
    grpc
    proxy grpc-backend:50051
    lb round_robin
}

# Static Assets (CDN)
https://cdn.example.com {
    proxy cdn-origin:9000
    compress gzip br
    timeout 30s
}

# Metrics and Monitoring
https://metrics.example.com {
    /metrics {
        # Prometheus metrics endpoint
        proxy localhost:9090
    }

    /grafana/* {
        proxy grafana:3000
    }
}

# Database Load Balancers
:3306 mysql {
    proxy mysql-primary:3306 mysql-replica1:3306 mysql-replica2:3306
    lb least_conn
    pool max=1000 min=50
}

:5432 postgres {
    proxy pg1:5432 pg2:5432
    pool max=500 min=20
}

:6379 redis {
    proxy redis1:6379 redis2:6379 redis3:6379
    lb consistent_hash
    pool max=200 min=10
}
