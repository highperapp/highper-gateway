//! Caddy-like DSL Grammar
//!
//! This grammar defines a simple, intuitive configuration language
//! for reverse proxy configuration inspired by Caddy.
//!
//! Example:
//!   example.com proxy localhost:3000
//!   https://api.example.com {
//!       /api/* proxy backend:8080
//!       cors
//!   }

WHITESPACE = _{ " " | "\t" | "\r" }
COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* ~ NEWLINE? }
newline = _{ NEWLINE }

// Top-level config file
config = {
    SOI ~
    newline* ~
    (global_directive | site)* ~
    EOI
}

// Global directives (apply to all sites)
global_directive = {
    log_directive
  | logging_directive
  | admin_directive
  | metrics_directive
  | buffer_pool_directive
  | backpressure_directive
}

// Simple log directive (backward compatibility)
log_directive = { "log" ~ log_level ~ newline }

// Enhanced logging directive with full configuration
logging_directive = {
    "logging" ~ "{" ~ newline* ~
    (newline* ~ logging_option)* ~ newline* ~
    "}" ~ newline*
}

logging_option = {
    ("format" ~ log_format ~ newline)
  | ("level" ~ log_level ~ newline)
  | ("output" ~ log_output ~ newline)
  | protocol_log_levels
}

log_level = { "trace" | "debug" | "info" | "warn" | "error" }
log_format = { "json" | "pretty" }
log_output = @{ (!newline ~ ANY)+ }

// Protocol-specific log levels
protocol_log_levels = {
    "protocols" ~ "{" ~ newline* ~
    (newline* ~ protocol_log_level)* ~ newline* ~
    "}" ~ newline*
}

protocol_log_level = {
    protocol_name ~ log_level ~ newline
}

protocol_name = {
    "tcp" | "tls" | "quic" | "grpc" | "graphql" | "http" | "websocket" | "cache"
}

admin_directive = { "admin" ~ admin_address ~ newline }
admin_address = @{ (domain ~ port?) | (":" ~ port) }

metrics_directive = { "metrics" ~ metrics_option* ~ newline }

metrics_option = {
    "prometheus"
  | "port=" ~ number
  | "on"
  | "off"
}

// Site definition
site = {
    site_address ~ (site_block | simple_proxy) ~ newline*
}

site_address = {
    (scheme? ~ domain ~ (":" ~ port)? ~ path?)  // HTTP/HTTPS/gRPC
  | (":" ~ port ~ tcp_protocol?)                 // TCP-only (e.g., :3306 mysql)
}

scheme = { "https://" | "http://" | "grpc://" }

domain = @{
    (ASCII_ALPHANUMERIC | "-")+ ~ ("." ~ (ASCII_ALPHANUMERIC | "-")+)*
  | "localhost"
}

port = @{ ASCII_DIGIT{1,5} }

path = { "/" ~ path_segment ~ ("/" ~ path_segment)* ~ "/"? }
path_segment = @{ (ASCII_ALPHANUMERIC | "-" | "_" | "." | "*")+ }

tcp_protocol = { "mysql" | "postgres" | "redis" | "tcp" }

// Simple one-line proxy
simple_proxy = { "proxy" ~ backend+ }

// Block with multiple directives
site_block = {
    "{" ~ newline* ~
    (newline* ~ (route | directive))* ~ newline* ~
    "}" ~ newline*
}

// Path-based route
route = {
    path ~ (route_block | simple_proxy) ~ newline*
}

route_block = {
    "{" ~ newline* ~
    (newline* ~ directive)* ~ newline* ~
    "}" ~ newline*
}

// Directives
directive = {
    proxy_directive
  | tcp_directive
  | lb_directive
  | pool_directive
  | health_directive
  | tls_directive
  | tls_protocols_directive
  | tls_client_auth_directive
  | cors_directive
  | websocket_directive
  | websocket_config_directive
  | grpc_directive
  | grpc_config_directive
  | http2_directive
  | http3_directive
  | quic_directive
  | compress_directive
  | compress_config_directive
  | rate_limit_directive
  | timeout_directive
  | request_timeout_directive
  | headers_directive
  | header_add_directive
  | header_remove_directive
  | header_passthrough_directive
  | circuit_breaker_directive
  | keepalive_directive
  | max_conns_directive
  | connect_timeout_directive
  | idle_timeout_directive
  | websocket_timeout_directive
  | grpc_timeout_directive
  | buffer_pool_directive
  | backpressure_directive
  | cache_directive
  | waf_directive
  | graphql_directive
  | php_fpm_directive
  | static_files_directive
  | root_directive
  | index_directive
  | try_files_directive
  | error_page_directive
  | directory_listing_directive
  | limits_directive
  | security_headers_directive
  | auth_directive
  | retry_directive
  | discovery_directive
  | geo_routing_directive
  | firewall_directive
}

// Proxy directive: proxy backend1 backend2 ...
proxy_directive = { "proxy" ~ backend+ ~ newline }

backend = {
    scheme? ~ domain ~ (":" ~ port)?
  | ip_address ~ (":" ~ port)?
}

ip_address = @{
    ASCII_DIGIT{1,3} ~ "." ~ ASCII_DIGIT{1,3} ~ "." ~
    ASCII_DIGIT{1,3} ~ "." ~ ASCII_DIGIT{1,3}
}

// TCP-specific directives
tcp_directive = {
    tcp_protocol ~ proxy_directive?
}

// Load balancing: lb round_robin | least_conn | ip_hash | random | weighted | consistent_hash
lb_directive = {
    "lb" ~ lb_algorithm ~ newline
}

lb_algorithm = {
    "round_robin"
  | "least_conn"
  | "ip_hash"
  | "random"
  | "weighted"
  | "consistent_hash"
}

// Connection pool: pool max=500 min=20 lifetime=1h
pool_directive = {
    "pool" ~ pool_option+ ~ newline
}

pool_option = {
    "max=" ~ number
  | "min=" ~ number
  | "min_idle=" ~ number
  | "max_idle=" ~ number
  | "max_open=" ~ number
  | "lifetime=" ~ duration
  | "idle=" ~ duration
  | "http2_multiplexing"
}

// Health checks: health interval=10s timeout=5s path=/health
health_directive = {
    "health" ~ health_option* ~ newline
}

health_option = {
    "interval=" ~ duration
  | "timeout=" ~ duration
  | "path=" ~ quoted_string
  | "healthy=" ~ number      // healthy threshold
  | "unhealthy=" ~ number    // unhealthy threshold
  | "grpc"
}

// TLS: tls | tls internal | tls email@example.com | tls cert.pem key.pem
tls_directive = {
    "tls" ~ (
        "internal"                             // Self-signed
      | email                                  // Auto ACME
      | (("cert=" ~ quoted_string | quoted_string) ~ ("key=" ~ quoted_string | quoted_string))       // Cert + key files
    )? ~ newline
}

email = @{ (ASCII_ALPHANUMERIC | "." | "-" | "_" | "+")+ ~ "@" ~ domain }

// TLS protocols: tls_protocols TLSv1.2 TLSv1.3
tls_protocols_directive = {
    "tls_protocols" ~ tls_version+ ~ newline
}

tls_version = { "TLSv1.2" | "TLSv1.3" }

// CORS: cors | cors origins=https://example.com
cors_directive = {
    "cors" ~ cors_option* ~ newline
}

cors_option = {
    "origins=" ~ quoted_string
  | "methods=" ~ quoted_string
  | "headers=" ~ quoted_string
  | "credentials"
}

// WebSocket: websocket
websocket_directive = { "websocket" ~ newline }

// gRPC: grpc
grpc_directive = { "grpc" ~ newline }

// Compression: compress | compress gzip | compress gzip br
compress_directive = {
    "compress" ~ compression_algo* ~ newline
}

compression_algo = { "gzip" | "br" | "deflate" | "zstd" }

// Rate limiting: rate_limit 100 per 1s | rate_limit 100 burst=50 per_ip
rate_limit_directive = {
    "rate_limit" ~ number ~ ("burst=" ~ number)? ~ ("per" ~ duration)? ~ "per_ip"? ~ newline
}

// Timeout: timeout 30s
timeout_directive = {
    "timeout" ~ duration ~ newline
}

// Headers: header_up Host {upstream_hostport} | header_down Server "highper-gateway"
headers_directive = {
    ("header_up" | "header_down") ~ header_name ~ header_value ~ newline
}

header_name = @{ (ASCII_ALPHANUMERIC | "-")+ }
header_value = { quoted_string | variable }
variable = @{ "{" ~ (ASCII_ALPHANUMERIC | "_")+ ~ "}" }

// Primitives
number = @{ ASCII_DIGIT+ }

duration = @{
    number ~ ("ms" | "s" | "m" | "h" | "d")
}

quoted_string = @{
    "\"" ~ (!"\"" ~ ANY)* ~ "\""
}

// TLS passthrough: :9443 tls-passthrough example.com -> backend:443
tls_passthrough_directive = {
    "tls-passthrough" ~ domain ~ "->" ~ backend ~ newline
}

// Keepalive: keepalive 90s
keepalive_directive = {
    "keepalive" ~ duration ~ newline
}

// Max connections: max_conns 3000000
max_conns_directive = {
    "max_conns" ~ number ~ newline
}

// Connect timeout: connect_timeout 5s
connect_timeout_directive = {
    "connect_timeout" ~ duration ~ newline
}

// Idle timeout: idle_timeout 300s
idle_timeout_directive = {
    "idle_timeout" ~ duration ~ newline
}

// Buffer pool: buffer_pool enabled size=16384 pool_size=16777216
buffer_pool_directive = {
    "buffer_pool" ~ buffer_pool_option+ ~ newline
}

buffer_pool_option = {
    "enabled"
  | "size=" ~ number
  | "pool_size=" ~ number
}

// Backpressure: backpressure enabled max_conns=3000000 memory_limit=49152mb
backpressure_directive = {
    "backpressure" ~ backpressure_option+ ~ newline
}

backpressure_option = {
    "enabled"
  | "max_conns=" ~ number
  | "memory_limit=" ~ memory_size
}

memory_size = @{ number ~ ("kb" | "mb" | "gb" | "tb") }

// Request timeout: request_timeout 30s
request_timeout_directive = {
    "request_timeout" ~ duration ~ newline
}

// Header add: header_add X-Custom "value"
header_add_directive = {
    "header_add" ~ header_name ~ header_value ~ newline
}

// Header remove: header_remove X-Powered-By
header_remove_directive = {
    "header_remove" ~ header_name ~ newline
}

// Header passthrough: header_passthrough Sec-WebSocket-Protocol Sec-WebSocket-Extensions
header_passthrough_directive = {
    "header_passthrough" ~ header_name+ ~ newline
}

// Circuit breaker: circuit_breaker threshold=10 timeout=30s window=60s
circuit_breaker_directive = {
    "circuit_breaker" ~ circuit_breaker_option+ ~ newline
}

circuit_breaker_option = {
    "threshold=" ~ number
  | "timeout=" ~ duration
  | "window=" ~ duration
}

// Compress with level: compress gzip level=5
compress_config_directive = {
    "compress" ~ compression_algo+ ~ ("level=" ~ number) ~ newline
}

// WebSocket config directives
websocket_config_directive = {
    websocket_enabled_directive
  | websocket_max_message_size_directive
  | websocket_buffer_size_directive
  | websocket_compression_directive
}

websocket_enabled_directive = {
    "websocket" ~ "enabled" ~ newline
}

websocket_max_message_size_directive = {
    "websocket_max_message_size" ~ number ~ newline
}

websocket_buffer_size_directive = {
    "websocket_buffer_size" ~ number ~ newline
}

websocket_compression_directive = {
    "websocket_compression" ~ ("enabled" | "disabled") ~ newline
}

// WebSocket timeout: websocket_timeout 7200s
websocket_timeout_directive = {
    "websocket_timeout" ~ duration ~ newline
}

// gRPC config directives
grpc_config_directive = {
    grpc_enabled_directive
  | grpc_timeout_directive_inline
  | grpc_max_message_size_directive
}

grpc_enabled_directive = {
    "grpc" ~ "enabled" ~ newline
}

grpc_timeout_directive_inline = {
    "grpc_timeout" ~ duration ~ newline
}

grpc_max_message_size_directive = {
    "grpc_max_message_size" ~ number ~ newline
}

// gRPC timeout: grpc_timeout 60s
grpc_timeout_directive = {
    "grpc_timeout" ~ duration ~ newline
}

// HTTP/2 directives
http2_directive = {
    http2_enabled_directive
  | http2_max_concurrent_streams_directive
  | http2_initial_window_size_directive
}

http2_enabled_directive = {
    "http2" ~ "enabled" ~ newline
}

http2_max_concurrent_streams_directive = {
    "http2_max_concurrent_streams" ~ number ~ newline
}

http2_initial_window_size_directive = {
    "http2_initial_window_size" ~ number ~ newline
}

// HTTP/3 directives
http3_directive = {
    http3_enabled_directive
  | http3_max_streams_directive
  | http3_initial_max_data_directive
}

http3_enabled_directive = {
    "http3" ~ "enabled" ~ ("port=" ~ number)? ~ newline
}

http3_max_streams_directive = {
    "http3_max_streams" ~ number ~ newline
}

http3_initial_max_data_directive = {
    "http3_initial_max_data" ~ number ~ newline
}

// QUIC directives
quic_directive = {
    quic_ack_delay_directive
  | quic_max_idle_timeout_directive
}

quic_ack_delay_directive = {
    "quic_ack_delay" ~ duration ~ newline
}

quic_max_idle_timeout_directive = {
    "quic_max_idle_timeout" ~ duration ~ newline
}

// Cache directives
cache_directive = {
    "cache" ~ cache_option+ ~ newline
}

cache_option = {
    "enabled"
  | "ttl=" ~ duration
  | "max_size=" ~ number
  | "cleanup_interval=" ~ duration
  | "only_success"
  | "methods" ~ http_method+
  | "key_headers" ~ header_name+
}

http_method = { "GET" | "POST" | "PUT" | "DELETE" | "HEAD" | "OPTIONS" | "PATCH" }

// WAF (Web Application Firewall) directives
waf_directive = {
    "waf" ~ waf_option+ ~ (waf_block | newline)
}

waf_option = {
    "enabled"
  | "mode=" ~ waf_mode
  | "block"
  | "log_only"
  | "max_body_size=" ~ number
}

waf_mode = { "custom" | "modsecurity" | "coraza" | "aws" }

waf_block = {
    "{" ~ newline* ~
    (waf_engine_directive ~ newline*)* ~
    "}" ~ newline*
}

waf_engine_directive = {
    modsecurity_directive
  | aws_waf_directive
  | coraza_directive
  | waf_rule_directive
}

// ModSecurity configuration
modsecurity_directive = {
    "modsecurity" ~ modsecurity_block
}

modsecurity_block = {
    "{" ~ newline* ~
    (modsecurity_option ~ newline)* ~
    "}" ~ newline*
}

modsecurity_option = {
    "rules_file" ~ quoted_string
  | "paranoia_level" ~ number
  | "audit_log" ~ quoted_string
}

// AWS WAF configuration
aws_waf_directive = {
    "aws_waf" ~ aws_waf_block
}

aws_waf_block = {
    "{" ~ newline* ~
    (aws_waf_option ~ newline)* ~
    "}" ~ newline*
}

aws_waf_option = {
    "web_acl_id" ~ quoted_string
  | "region" ~ identifier
  | "api_mode" ~ identifier
}

// Coraza configuration
coraza_directive = {
    "coraza" ~ coraza_block
}

coraza_block = {
    "{" ~ newline* ~
    (coraza_option ~ newline)* ~
    "}" ~ newline*
}

coraza_option = {
    "rules_dir" ~ quoted_string
  | "audit_log" ~ quoted_string
}

// WAF rules
waf_rule_directive = {
    "waf_rule" ~ waf_rule_type ~ waf_rule_action
}

waf_rule_type = {
    "sql_injection"
  | "xss"
  | "path_traversal"
  | "rate_limit"
  | "user_agent"
  | "method"
}

waf_rule_action = { "enabled" | "disabled" | "block" | "log" }

identifier = @{ (ASCII_ALPHANUMERIC | "-" | "_")+ }

// GraphQL directives
graphql_directive = {
    "graphql" ~ graphql_option* ~ (graphql_block | newline)
}

graphql_option = {
    "enabled"
  | "endpoint=" ~ quoted_string
  | "introspection"
  | "cache" ~ "ttl=" ~ duration
  | "batching" ~ "max_size=" ~ number
}

graphql_block = {
    "{" ~ newline* ~
    (newline* ~ graphql_stitching_directive)* ~ newline* ~
    "}" ~ newline*
}

graphql_stitching_directive = {
    "stitching" ~ "{" ~ newline* ~
    (newline* ~ graphql_backend_block)* ~ newline* ~
    "}" ~ newline*
}

graphql_backend_block = {
    "backend" ~ identifier ~ "{" ~ newline* ~
    (newline* ~ graphql_backend_option)* ~ newline* ~
    "}" ~ newline*
}

graphql_backend_option = {
    "url" ~ quoted_string ~ newline
  | "namespace" ~ identifier ~ newline
}

// PHP-FPM directives
php_fpm_directive = {
    "php_fpm" ~ php_fpm_option+ ~ newline
}

php_fpm_option = {
    "enabled"
  | "socket=" ~ quoted_string
  | "pool_size=" ~ number
  | "connect_timeout=" ~ duration
  | "read_timeout=" ~ duration
  | "write_timeout=" ~ duration
  | "keepalive=" ~ duration
  | "script_extensions" ~ file_extension+
}

file_extension = @{ "." ~ (ASCII_ALPHANUMERIC)+ }

// Static file serving directives
static_files_directive = {
    "static_files" ~ newline
}

root_directive = {
    "root" ~ quoted_string ~ newline
}

index_directive = {
    "index" ~ filename+ ~ newline
}

filename = @{ (ASCII_ALPHANUMERIC | "." | "-" | "_")+ }

try_files_directive = {
    "try_files" ~ try_files_pattern+ ~ newline
}

try_files_pattern = {
    "$uri/"
  | "$uri"
  | variable
  | quoted_string
  | "=" ~ number  // HTTP status code fallback
  | path  // Unquoted path like /index.php
}

error_page_directive = {
    "error_page" ~ number ~ quoted_string ~ newline
}

directory_listing_directive = {
    "directory_listing" ~ ("on" | "off") ~ newline
}

limits_directive = {
    "limits" ~ limit_param+ ~ newline
}

limit_param = {
    "max_file_size=" ~ byte_size
  | "max_request_body=" ~ byte_size
  | "max_upload_size=" ~ byte_size
  | "max_path_depth=" ~ number
  | "max_connections_per_ip=" ~ number
  | "max_requests_per_second=" ~ number
}

byte_size = @{
    number ~ ("KB" | "MB" | "GB" | "B")?
}

// ============================================================================
// NEW DIRECTIVES - Extended for full feature support
// ============================================================================

// Security Headers: security_headers { ... } or security_headers enabled
security_headers_directive = {
    "security_headers" ~ (security_headers_block | security_headers_inline) ~ newline*
}

security_headers_inline = {
    "enabled" ~ newline
}

security_headers_block = {
    "{" ~ newline* ~
    (security_headers_option ~ newline)* ~
    "}" ~ newline*
}

security_headers_option = {
    "enabled"
  | "x_frame_options" ~ quoted_string
  | "x_content_type_options" ~ quoted_string
  | "x_xss_protection" ~ quoted_string
  | "strict_transport_security" ~ quoted_string
  | "hsts" ~ quoted_string  // Alias for strict_transport_security
  | "content_security_policy" ~ quoted_string
  | "csp" ~ quoted_string  // Alias for content_security_policy
  | "referrer_policy" ~ quoted_string
  | "permissions_policy" ~ quoted_string
  | "custom" ~ header_name ~ quoted_string
}

// TLS Client Authentication (mTLS): tls_client_auth { ... }
tls_client_auth_directive = {
    "tls_client_auth" ~ tls_client_auth_block ~ newline*
}

tls_client_auth_block = {
    "{" ~ newline* ~
    (tls_client_auth_option ~ newline)* ~
    "}" ~ newline*
}

tls_client_auth_option = {
    "enabled"
  | "required"
  | "optional"
  | "ca_cert" ~ quoted_string
  | "ca_file" ~ quoted_string  // Alias for ca_cert
  | "verify_depth" ~ number
  | "verify_client" ~ ("on" | "off" | "optional")
  | "crl_file" ~ quoted_string
}

// Authentication: auth { type jwt ... } or auth { type oauth2 ... }
auth_directive = {
    "auth" ~ auth_block ~ newline*
}

auth_block = {
    "{" ~ newline* ~
    (auth_option ~ newline)* ~
    "}" ~ newline*
}

auth_option = {
    "type" ~ auth_type
  | "enabled"
  | jwt_auth_option
  | oauth2_auth_option
  | basic_auth_option
  | api_key_auth_option
}

auth_type = { "jwt" | "oauth2" | "basic" | "api_key" }

// JWT authentication options
jwt_auth_option = {
    "secret" ~ (quoted_string | env_var)
  | "algorithm" ~ jwt_algorithm
  | "header" ~ quoted_string
  | "prefix" ~ quoted_string
  | "claims_required" ~ identifier+
  | "claims_validation" ~ ("enabled" | "required")
  | "validate_exp" ~ bool_value
  | "validate_nbf" ~ bool_value
  | "issuer" ~ quoted_string
  | "audience" ~ quoted_string
}

jwt_algorithm = { "HS256" | "HS384" | "HS512" | "RS256" | "RS384" | "RS512" | "ES256" | "ES384" | "ES512" }

// OAuth2 authentication options
oauth2_auth_option = {
    "provider" ~ oauth2_provider
  | "client_id" ~ (quoted_string | env_var)
  | "client_secret" ~ (quoted_string | env_var)
  | "scopes" ~ quoted_string_array
  | "callback_url" ~ quoted_string
  | "authorize_url" ~ quoted_string
  | "token_url" ~ quoted_string
  | "userinfo_url" ~ quoted_string
}

oauth2_provider = { "google" | "github" | "facebook" | "microsoft" | "okta" | "auth0" | "custom" }

// Basic authentication options
basic_auth_option = {
    "realm" ~ quoted_string
  | "htpasswd_file" ~ quoted_string
  | "users" ~ basic_auth_users_block
}

basic_auth_users_block = {
    "{" ~ newline* ~
    (basic_auth_user ~ newline)* ~
    "}" ~ newline*
}

basic_auth_user = {
    identifier ~ ":" ~ quoted_string  // username:password_hash
}

// API Key authentication options
api_key_auth_option = {
    "header" ~ quoted_string
  | "query_param" ~ quoted_string
  | "keys" ~ quoted_string_array
  | "keys_file" ~ quoted_string
}

// Retry Policy: retry { attempts 3 backoff exponential ... }
retry_directive = {
    "retry" ~ retry_block ~ newline*
}

retry_block = {
    "{" ~ newline* ~
    (retry_option ~ newline)* ~
    "}" ~ newline*
}

retry_option = {
    "enabled"
  | "attempts" ~ number
  | "backoff" ~ backoff_strategy
  | "initial_delay" ~ duration
  | "max_delay" ~ duration
  | "multiplier" ~ float_number
  | "jitter" ~ ("enabled" | "disabled")
  | "retry_on" ~ retry_condition+
}

backoff_strategy = { "exponential" | "linear" | "constant" | "fibonacci" }

retry_condition = {
    "5xx"
  | "connection_error"
  | "timeout"
  | "status_code" ~ number
}

// Service Discovery: discovery { provider consul ... }
discovery_directive = {
    "discovery" ~ discovery_block ~ newline*
}

discovery_block = {
    "{" ~ newline* ~
    (discovery_option ~ newline)* ~
    "}" ~ newline*
}

discovery_option = {
    "provider" ~ discovery_provider
  | "address" ~ quoted_string
  | "service_name" ~ quoted_string
  | "refresh_interval" ~ duration
  | "health_check" ~ ("enabled" | "disabled")
  | "tags" ~ quoted_string_array
  | consul_discovery_option
  | etcd_discovery_option
  | kubernetes_discovery_option
  | dns_discovery_option
}

discovery_provider = { "consul" | "etcd" | "kubernetes" | "dns" | "static" }

// Consul-specific options
consul_discovery_option = {
    "datacenter" ~ quoted_string
  | "token" ~ (quoted_string | env_var)
  | "namespace" ~ quoted_string
  | "passing_only" ~ bool_value
}

// Etcd-specific options
etcd_discovery_option = {
    "prefix" ~ quoted_string
  | "username" ~ quoted_string
  | "password" ~ (quoted_string | env_var)
}

// Kubernetes-specific options
kubernetes_discovery_option = {
    "namespace" ~ quoted_string
  | "label_selector" ~ quoted_string
  | "field_selector" ~ quoted_string
  | "port_name" ~ quoted_string
}

// DNS-specific options
dns_discovery_option = {
    "resolver" ~ quoted_string
  | "record_type" ~ dns_record_type
  | "port" ~ number
}

dns_record_type = { "A" | "AAAA" | "SRV" }

// Geographic Routing: geo_routing { ... }
geo_routing_directive = {
    "geo_routing" ~ geo_routing_block ~ newline*
}

geo_routing_block = {
    "{" ~ newline* ~
    (geo_routing_option ~ newline)* ~
    (geo_region_block ~ newline*)* ~
    (geo_default_block ~ newline?)? ~
    "}" ~ newline*
}

geo_routing_option = {
    "enabled"
  | "database" ~ quoted_string
  | "database_type" ~ geo_database_type
  | "fallback" ~ ("closest" | "random" | "round_robin")
}

geo_database_type = { "maxmind" | "ip2location" | "dbip" | "geoip2" }

// Geographic region definition
geo_region_block = {
    "region" ~ identifier ~ "{" ~ newline* ~
    (geo_region_option ~ newline)* ~
    "}" ~ newline*
}

geo_region_option = {
    "countries" ~ country_code_array
  | "continents" ~ continent_code_array
  | "cities" ~ quoted_string_array
  | "ip_ranges" ~ cidr_array
  | "proxy" ~ backend+
  | "weight" ~ number
}

geo_default_block = {
    "default" ~ ("proxy" ~ backend+ | "{" ~ newline* ~ (geo_region_option ~ newline)* ~ "}" ~ newline*)
}

// Firewall / IP ACL: firewall { ... }
firewall_directive = {
    "firewall" ~ firewall_block ~ newline*
}

firewall_block = {
    "{" ~ newline* ~
    (firewall_option ~ newline)* ~
    "}" ~ newline*
}

firewall_option = {
    "enabled"
  | "mode" ~ firewall_mode
  | "allowlist" ~ (cidr_array | firewall_list_block)
  | "blocklist" ~ (cidr_array | firewall_list_block)
  | "whitelist" ~ (cidr_array | firewall_list_block)  // Alias for allowlist
  | "blacklist" ~ (cidr_array | firewall_list_block)  // Alias for blocklist
  | "allow" ~ cidr_array
  | "deny" ~ cidr_array
  | "max_connections_per_ip" ~ number
  | "rate_limit" ~ number ~ ("per_second" | "per_minute")
  | "geo_block" ~ country_code_array
  | "geo_allow" ~ country_code_array
}

firewall_mode = { "allow" | "deny" }

firewall_list_block = {
    "[" ~ newline* ~
    (cidr_value ~ ("," ~ newline*)?)* ~
    "]"
}

// ============================================================================
// HELPER TYPES
// ============================================================================

// Environment variable: env("VAR_NAME")
env_var = { "env(" ~ quoted_string ~ ")" }

// Boolean values
bool_value = { "true" | "false" | "on" | "off" | "yes" | "no" }

// Float number: 1.5, 2.0, etc.
float_number = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }

// Array of quoted strings: ["item1", "item2"]
quoted_string_array = {
    "[" ~ newline* ~
    (quoted_string ~ ("," ~ newline*)?)* ~
    "]"
}

// Array of country codes: [US, CA, MX]
country_code_array = {
    "[" ~ newline* ~
    (country_code ~ ("," ~ newline*)?)* ~
    "]"
}

country_code = @{ ASCII_ALPHA{2} }  // ISO 3166-1 alpha-2

// Array of continent codes: [NA, EU, AS]
continent_code_array = {
    "[" ~ newline* ~
    (continent_code ~ ("," ~ newline*)?)* ~
    "]"
}

continent_code = @{ ASCII_ALPHA{2} }  // NA, EU, AS, AF, OC, SA, AN

// Array of CIDR blocks: ["10.0.0.0/8", "192.168.0.0/16"]
cidr_array = {
    "[" ~ newline* ~
    (cidr_value ~ ("," ~ newline*)?)* ~
    "]"
}

cidr_value = @{
    (quoted_string | cidr_notation)
}

// CIDR notation: 10.0.0.0/8
cidr_notation = @{
    ip_address ~ "/" ~ ASCII_DIGIT{1,2}
}
