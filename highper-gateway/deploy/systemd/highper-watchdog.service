[Unit]
Description=Highper Gateway Watchdog - Auto-recovery and Health Monitoring
Documentation=https://github.com/yourusername/highper-gateway
After=highper-gateway.service
Requires=highper-gateway.service

[Service]
Type=simple
User=highper
Group=highper
WorkingDirectory=/opt/highper-gateway

# Watchdog script location
ExecStart=/opt/highper-gateway/scripts/watchdog.sh

# Restart watchdog if it crashes
Restart=always
RestartSec=10s

# Standard output/error handling
StandardOutput=journal
StandardError=journal
SyslogIdentifier=highper-watchdog

# Environment
Environment="HEALTH_URL=http://localhost:9090/api/health"
Environment="MAX_FAILURES=3"
Environment="CHECK_INTERVAL=10"

[Install]
WantedBy=multi-user.target
