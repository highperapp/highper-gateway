# cargo-deny configuration for Rust Reverse Proxy
# This file configures security, license, and dependency checks

# Advisories check for known security vulnerabilities
[advisories]
db-path = "~/.cargo/advisory-db"
db-urls = ["https://github.com/rustsec/advisory-db"]
vulnerability = "deny"
unmaintained = "warn"
unsound = "warn"
yanked = "warn"
notice = "warn"
ignore = []
# Severity threshold
# severity-threshold = "low"

# Licenses check for license compliance
[licenses]
unlicensed = "deny"
allow = [
    "MIT",
    "Apache-2.0",
    "Apache-2.0 WITH LLVM-exception",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Unicode-DFS-2016",
    "Zlib",
    "0BSD",
]
deny = [
    "GPL-2.0",
    "GPL-3.0",
    "AGPL-3.0",
]
copyleft = "warn"
allow-osi-fsf-free = "both"
default = "deny"
confidence-threshold = 0.8

[[licenses.clarify]]
name = "ring"
expression = "MIT AND ISC AND OpenSSL"
license-files = [
    { path = "LICENSE", hash = 0xbd0eed23 }
]

# Bans check for specific crates or multiple versions
[bans]
multiple-versions = "warn"
wildcards = "warn"
highlight = "all"
workspace-default-features = "allow"
external-default-features = "allow"

# Specific crate denials (add problematic crates here)
deny = []

# Allow certain crates that commonly have multiple versions
skip = [
    # Common cases where multiple versions are acceptable
    { name = "bitflags", version = "*" },
    { name = "windows-sys", version = "*" },
    { name = "windows_x86_64_msvc", version = "*" },
]

skip-tree = []

# Sources check for crate sources
[sources]
unknown-registry = "warn"
unknown-git = "warn"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]
allow-git = []

[sources.allow-org]
github = ["tokio-rs", "hyperium", "serde-rs", "rust-lang"]
