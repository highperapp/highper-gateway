# Scenario 01: Layer 4 TCP Load Balancer
# Pure TCP proxying for generic TCP services
# Target: 600K+ connections/sec, minimal latency overhead

:8080 tcp {
    # Backend servers (localhost for testing, replace with actual IPs for production)
    proxy http://127.0.0.1:8081 http://127.0.0.1:8082 http://127.0.0.1:8083
    # Layer 4 load balancing
    lb round_robin
    # Health checks
    health interval=10s timeout=5s
    # Connection limits
    max_conns 3000000
    # Timeouts
    connect_timeout 5s
    idle_timeout 300s
}

# Global settings
log info
metrics prometheus port=9090
buffer_pool enabled size=16384 pool_size=16777216
