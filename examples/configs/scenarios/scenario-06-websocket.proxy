# Scenario 06: WebSocket Proxying
# Full WebSocket support with connection upgrade, keep-alive, and message routing.
# For advanced WebSocket options, use YAML format (scenario-06-websocket.yaml).

https://ws.loadtest.local:8446 {
    tls "$CERT_PATH/api.crt" "$CERT_PATH/api.key"
    proxy 127.0.0.1:8081 127.0.0.1:8082 127.0.0.1:8083
    lb round_robin
}

log info
metrics prometheus port=9090
