# Scenario 02: Layer 7 HTTP + TLS Termination
# Target: 600-800K RPS, 3M concurrent connections
# Use Case: Production HTTPS API gateway with TLS termination

name: "Layer 7 HTTP + TLS Termination"
priority: "HIGH"
target_rps: 700000
target_concurrency: 3000000

# Server configuration
server:
  # Listen on all interfaces
  listen_address: "0.0.0.0"
  listen_port: 443

  # TLS termination
  tls:
    enabled: true
    cert_file: "/etc/highper/certs/server.crt"
    key_file: "/etc/highper/certs/server.key"
    min_tls_version: "1.2"
    ciphersuites:
      - "TLS_AES_256_GCM_SHA384"
      - "TLS_AES_128_GCM_SHA256"
      - "TLS_CHACHA20_POLY1305_SHA256"

  # Connection limits
  max_connections: 3000000
  connection_timeout: 60s
  keepalive_timeout: 90s

  # Buffer pool (16MB * 16384 = 256GB for 3M connections)
  buffer_pool:
    enabled: true
    buffer_size: 16384  # 16KB buffers
    pool_size: 16777216  # 16M buffers pre-allocated

# Load balancing
load_balancer:
  algorithm: "round_robin"  # round_robin, least_connections, maglev

  # Backend servers (will be populated by deploy script)
  backends:
    - address: "backend-1.internal:8080"
      weight: 1
      max_connections: 1000000
    - address: "backend-2.internal:8080"
      weight: 1
      max_connections: 1000000
    - address: "backend-3.internal:8080"
      weight: 1
      max_connections: 1000000

  # Health checks
  health_check:
    enabled: true
    interval: 10s
    timeout: 5s
    path: "/health"
    healthy_threshold: 2
    unhealthy_threshold: 3

# Connection pool
connection_pool:
  enabled: true
  min_idle: 100
  max_idle: 10000
  max_open: 1000000
  idle_timeout: 300s
  max_lifetime: 3600s

# Rate limiting
rate_limit:
  enabled: true
  requests_per_second: 700000
  burst: 100000
  algorithm: "token_bucket"

# Circuit breaker
circuit_breaker:
  enabled: true
  failure_threshold: 5
  success_threshold: 2
  timeout: 30s
  half_open_requests: 3

# Security features
security:
  # Security headers
  headers:
    enabled: true
    preset: "default"  # default, strict, relaxed, custom
    hsts_max_age: 31536000
    content_security_policy: "default-src 'self'"
    x_frame_options: "DENY"
    x_content_type_options: "nosniff"

  # Request size limits
  request_size_limit:
    enabled: true
    max_size: "10MB"
    custom_error_message: "Request too large"

# Observability
observability:
  # Metrics
  metrics:
    enabled: true
    export_interval: 10s
    prometheus:
      enabled: true
      port: 9090

  # Tracing
  tracing:
    enabled: true
    exporter: "jaeger"
    endpoint: "localhost:6831"
    sampling_rate: 0.01  # 1% sampling at high scale

  # Logging
  logging:
    level: "info"
    format: "json"
    output: "stdout"

# Performance tuning
performance:
  # Worker threads (usually number of CPU cores)
  worker_threads: 32

  # TCP tuning
  tcp:
    nodelay: true
    keepalive: true
    keepalive_idle: 60
    keepalive_interval: 10
    keepalive_count: 3

  # Zero-copy optimizations
  zero_copy:
    enabled: true
    sendfile: true

# Backpressure and load shedding
backpressure:
  enabled: true
  max_connections: 3000000
  memory_limit_mb: 49152  # 48GB
  cpu_threshold: 90

# Panic recovery
panic_recovery:
  enabled: true
  log_panics: true
  recover_from_panics: true
