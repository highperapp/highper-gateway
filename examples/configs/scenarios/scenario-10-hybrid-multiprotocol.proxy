# Scenario 10: Hybrid Multi-Protocol (Simplified)
# Note: Using basic HTTPS and TCP only

https://multi.loadtest.local:8450 {
    tls "/mnt/e/my-opensource/highper-gateway/certs/api.crt" "/mnt/e/my-opensource/highper-gateway/certs/api.key"
    proxy 127.0.0.1:8081 127.0.0.1:8082 127.0.0.1:8083
    lb round_robin
}

:5000 tcp {
    proxy http://127.0.0.1:15000 http://127.0.0.1:15001 http://127.0.0.1:15002
    lb round_robin
}

log info
metrics prometheus port=9090
