# Scenario 05: HTTP/3 + QUIC
# HTTP/3 with QUIC transport is fully implemented via quiche library.
# For full HTTP/3 configuration options, use YAML format (scenario-05-http3-quic.yaml).

https://http3.loadtest.local:8445 {
    tls "$CERT_PATH/api.crt" "$CERT_PATH/api.key"
    proxy 127.0.0.1:8081 127.0.0.1:8082 127.0.0.1:8083
    lb round_robin
}

log info
metrics prometheus port=9090
