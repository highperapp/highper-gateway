# Highper Gateway Configuration
# Generated by Ansible
# Use Case: {{ highper_gateway_use_case }}
# Environment: {{ highper_gateway_environment }}

server:
  name: "highper-gateway-{{ highper_gateway_environment }}"

# io_uring configuration
io_uring:
  entries: {{ highper_gateway_iouring_entries }}
  sq_poll: {{ highper_gateway_iouring_sq_poll | lower }}
{% if highper_gateway_iouring_sq_poll %}
  sq_poll_cpu: {{ highper_gateway_iouring_sq_poll_cpu }}
{% endif %}

# Logging
logging:
  level: {{ highper_gateway_log_level }}
  format: {{ highper_gateway_log_format }}
  output: {{ highper_gateway_log_dir }}/gateway.log

# Metrics
metrics:
  enabled: {{ highper_gateway_metrics_enabled | lower }}
{% if highper_gateway_metrics_enabled %}
  endpoint: {{ highper_gateway_metrics_endpoint }}
  port: {{ highper_gateway_metrics_port }}
{% endif %}

# Health check
health:
  enabled: {{ highper_gateway_health_enabled | lower }}
{% if highper_gateway_health_enabled %}
  endpoint: {{ highper_gateway_health_endpoint }}
  port: {{ highper_gateway_health_port }}
{% endif %}

{% if highper_gateway_tls_enabled %}
# TLS configuration
tls:
  enabled: true
  cert: {{ highper_gateway_config_dir }}/certs/server.crt
  key: {{ highper_gateway_config_dir }}/certs/server.key
{% if highper_gateway_tls_ca_path | length > 0 %}
  ca: {{ highper_gateway_config_dir }}/certs/ca.crt
{% endif %}
{% endif %}

{% if highper_gateway_backends | length > 0 %}
# Backend pools
backends:
{% for backend in highper_gateway_backends %}
  - name: {{ backend.name }}
    servers:
{% for server in backend.servers %}
      - {{ server }}
{% endfor %}
{% if backend.health_check is defined and backend.health_check.enabled %}
    health_check:
      enabled: true
      path: {{ backend.health_check.path | default('/health') }}
      interval: {{ backend.health_check.interval | default(10) }}
{% endif %}
{% endfor %}
{% endif %}
