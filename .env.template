# Load Test Environment Variables
# Copy this file to .env and fill in your API credentials
# IMPORTANT: Never commit .env to git!

# ==============================================================================
# VULTR API CREDENTIALS
# ==============================================================================
# Get from: https://my.vultr.com/settings/#settingsapi
# Permissions: Full access to Bare Metal servers
VULTR_API_KEY="your-vultr-api-key-here"

# Vultr Settings
VULTR_REGION="ewr"  # ewr (NJ), lax (LA), fra (Frankfurt), etc.
VULTR_PROXY_PLAN="vbm-32c-256gb"  # Bare metal 32-core
VULTR_BACKEND_PLAN="vbm-8c-64gb"   # Bare metal 8-core
VULTR_GENERATOR_PLAN="vbm-16c-128gb"  # Bare metal 16-core

# ==============================================================================
# HETZNER CLOUD API CREDENTIALS
# ==============================================================================
# Get from: https://console.hetzner.cloud/ → Security → API Tokens
# Permissions: Read & Write
HETZNER_CLOUD_TOKEN="your-hetzner-cloud-token-here"

# Hetzner Cloud Settings
HETZNER_CLOUD_LOCATION="fsn1"  # fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki)
HETZNER_CLOUD_PROXY_TYPE="ccx63"  # 48 vCPU, 192GB RAM
HETZNER_CLOUD_BACKEND_TYPE="ccx33"  # 16 vCPU, 64GB RAM
HETZNER_CLOUD_GENERATOR_TYPE="ccx43"  # 32 vCPU, 128GB RAM

# ==============================================================================
# HETZNER ROBOT API CREDENTIALS (Dedicated Servers)
# ==============================================================================
# Get from: https://robot.hetzner.com/ → Settings → Webservice
# Note: Username starts with #ws+
HETZNER_ROBOT_USER="your-robot-username-here"  # e.g., #ws+username
HETZNER_ROBOT_PASSWORD="your-robot-password-here"

# Hetzner Dedicated Settings
HETZNER_DEDICATED_LOCATION="FSN1-DC14"  # FSN1-DC14 (Falkenstein), NBG1-DC3 (Nuremberg)
HETZNER_DEDICATED_PROXY="AX102"  # AMD EPYC 7502P (32c/64t), 128GB RAM
HETZNER_DEDICATED_BACKEND="AX52"  # AMD Ryzen 9 5950X (16c/32t), 64GB RAM
HETZNER_DEDICATED_GENERATOR="AX62"  # AMD Ryzen 9 5950X (16c/32t), 128GB RAM

# ==============================================================================
# PHOENIXNAP API CREDENTIALS
# ==============================================================================
# Get from: https://bmc.phoenixnap.com/ → API Credentials
# Type: OAuth2 (Client ID + Secret)
PNAP_CLIENT_ID="your-phoenixnap-client-id-here"
PNAP_CLIENT_SECRET="your-phoenixnap-client-secret-here"

# PhoenixNAP Settings
PNAP_LOCATION="PHX"  # PHX (Phoenix), ASH (Ashburn), CHI (Chicago)
PNAP_PROXY_TYPE="s3.c3.large"  # 2x Xeon Gold 6230R (32c), 192GB RAM
PNAP_BACKEND_TYPE="s3.c1.medium"  # Intel Xeon E-2288G (8c/16t), 64GB RAM
PNAP_GENERATOR_TYPE="s3.c2.medium"  # 2x Xeon Gold 5218R (32c), 96GB RAM

# ==============================================================================
# LOAD TEST SETTINGS
# ==============================================================================
# Test duration (seconds)
LOAD_TEST_DURATION=180  # 3 minutes default

# Target RPS (requests per second)
LOAD_TEST_TARGET_RPS=600000  # 600K RPS

# Target concurrency
LOAD_TEST_TARGET_CONCURRENCY=3000000  # 3M connections

# Number of backend servers
LOAD_TEST_BACKEND_COUNT=3

# Number of load generators
LOAD_TEST_GENERATOR_COUNT=3

# Load testing tool (vegeta or wrk2)
# vegeta: Better metrics, JSON output, easier aggregation (recommended)
# wrk2: Lower overhead, good for extreme RPS scenarios
LOAD_TEST_TOOL=vegeta

# Results directory
LOAD_TEST_RESULTS_DIR="./results"

# ==============================================================================
# OBSERVABILITY SETTINGS
# ==============================================================================
# Enable Prometheus metrics collection
ENABLE_PROMETHEUS=true

# Enable Grafana dashboards
ENABLE_GRAFANA=true

# Enable Vector log aggregation
ENABLE_VECTOR=true

# Metrics export interval (seconds)
METRICS_EXPORT_INTERVAL=10

# ==============================================================================
# SSH SETTINGS
# ==============================================================================
# SSH key for server access (leave empty to use default ~/.ssh/id_rsa)
SSH_KEY_PATH=""

# SSH user (default: root)
SSH_USER="root"

# ==============================================================================
# CLEANUP SETTINGS
# ==============================================================================
# Auto-cleanup on failure (true/false)
AUTO_CLEANUP_ON_FAILURE=true

# Auto-cleanup on success (true/false)
AUTO_CLEANUP_ON_SUCCESS=true

# Keep servers for debugging (overrides auto-cleanup)
KEEP_SERVERS_FOR_DEBUG=false

# ==============================================================================
# LOGGING SETTINGS
# ==============================================================================
# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL="INFO"

# Enable colored output
ENABLE_COLOR=true

# Save logs to file
SAVE_LOGS=true
