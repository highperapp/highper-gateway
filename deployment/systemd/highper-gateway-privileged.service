[Unit]
Description=Rust Reverse Proxy (Privileged Ports)
Documentation=https://github.com/yourusername/highper-gateway
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=highper-gateway
Group=highper-gateway

# Working directory
WorkingDirectory=/opt/highper-gateway

# Start the proxy
ExecStart=/usr/local/bin/highper-gateway start --config /etc/highper-gateway/config.toml

# Restart policy
Restart=always
RestartSec=5s

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening with privileged port binding
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/highper-gateway /var/lib/highper-gateway

# Allow binding to ports 80 and 443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=highper-gateway

[Install]
WantedBy=multi-user.target
